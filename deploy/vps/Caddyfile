# Installed by bootstrap.sh as /etc/caddy/Caddyfile.
# __SITE_ADDRESS__ is ":80" while the server is reached by IP (plain HTTP, no certificate).
# With a domain ("example.ru, www.example.ru") Caddy obtains and renews HTTPS itself.

__SITE_ADDRESS__ {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Mirror of the Vercel site: keep it out of search until DNS points here.
		__ROBOTS_HEADER__
	}

	# Hashed build assets: immutable, served from disk without touching Node.
	handle_path /_next/static/* {
		root * /srv/portfolio/current/.next/static
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Case videos, 3D models, fonts: byte ranges and caching from Caddy.
	@assets path /cases/* /fonts/* /demo-assets/*
	handle @assets {
		root * /srv/portfolio/current/public
		header Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
		@glb path *.glb
		header @glb Content-Type model/gltf-binary
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:3000 {
			# App Router streams HTML; do not buffer it.
			flush_interval -1
		}
	}

	log {
		output file /var/log/caddy/portfolio.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}
